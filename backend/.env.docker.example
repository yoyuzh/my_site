# Backend container runtime
SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8080
APP_JWT_SECRET=replace-with-at-least-32-bytes
APP_ADMIN_USERNAMES=
APP_AUTH_REGISTRATION_INVITE_CODE=

# Database
# Compose default: connect to the mysql service below.
# First-stage server rollout: point this to host.docker.internal:3306 to reuse host MySQL.
SPRING_DATASOURCE_URL=jdbc:mysql://mysql:3306/yoyuzh_portal?useSSL=false&serverTimezone=Asia/Shanghai&characterEncoding=utf8
SPRING_DATASOURCE_USERNAME=yoyuzh
SPRING_DATASOURCE_PASSWORD=change-me
SPRING_JPA_HIBERNATE_DDL_AUTO=update

# Redis
APP_REDIS_ENABLED=false
SPRING_DATA_REDIS_HOST=redis
SPRING_DATA_REDIS_PORT=6379

# Local file storage inside the container
YOYUZH_STORAGE_PROVIDER=local
YOYUZH_STORAGE_LOCAL_ROOT_DIR=/app/storage

# Optional S3-compatible storage
# YOYUZH_STORAGE_PROVIDER=s3
# YOYUZH_DOGECLOUD_API_BASE_URL=https://api.dogecloud.com
# YOYUZH_DOGECLOUD_API_ACCESS_KEY=replace-me
# YOYUZH_DOGECLOUD_API_SECRET_KEY=replace-me
# YOYUZH_DOGECLOUD_STORAGE_SCOPE=yoyuzh-files
# YOYUZH_DOGECLOUD_STORAGE_TTL_SECONDS=3600
# YOYUZH_DOGECLOUD_S3_REGION=automatic
