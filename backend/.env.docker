SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8080
APP_JWT_SECRET=local-docker-jwt-secret-please-change-1234567890
APP_ADMIN_USERNAMES=
APP_AUTH_REGISTRATION_INVITE_CODE=local-dev

SPRING_DATASOURCE_URL=jdbc:mysql://mysql:3306/yoyuzh_portal?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Shanghai&characterEncoding=utf8
SPRING_DATASOURCE_USERNAME=yoyuzh
